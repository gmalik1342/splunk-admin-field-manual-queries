``` LF-06 | Forwarders That Stopped Sending Data
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry LF-06. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH.
    Query: Main query
    If this returns nothing, run probes/LF-06-probe.spl to confirm the data it
    reads exists here.
```
index=_internal source=*metrics.log group=tcpin_connections earliest=-7d
| eval fwd=coalesce(hostname, sourceHost, sourceIp)
| stats latest(_time) as last_seen earliest(_time) as first_seen
        latest(sourceIp) as ip latest(fwdType) as fwd_type
        latest(version) as version dc(host) as indexers_used
        by fwd
| eval minutes_silent=round((now() - last_seen) / 60, 0)
| where minutes_silent >= 15
| eval status=case(minutes_silent < 60,    "SILENT <1h",
                   minutes_silent < 1440,  "SILENT <24h",
                   true(),                 "SILENT >=24h")
| convert ctime(last_seen) ctime(first_seen)
| sort minutes_silent
| table fwd ip fwd_type version indexers_used last_seen minutes_silent status
