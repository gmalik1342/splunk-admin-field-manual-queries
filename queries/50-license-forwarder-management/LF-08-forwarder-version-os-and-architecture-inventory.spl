``` LF-08 | Forwarder Version, OS, and Architecture Inventory
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry LF-08. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH.
    Query: Main query
    If this returns nothing, run probes/LF-08-probe.spl to confirm the data it
    reads exists here.
```
index=_internal source=*metrics.log group=tcpin_connections earliest=-24h
| eval fwd=coalesce(hostname, sourceHost, sourceIp)
| stats latest(version) as version latest(os) as os latest(arch) as arch
        latest(fwdType) as fwd_type latest(sourceIp) as ip
        latest(_time) as last_seen
        by fwd
| eval major_minor=replace(version, "^(\d+\.\d+).*", "\1")
| eventstats count as fleet_on_version by major_minor
| convert ctime(last_seen)
| sort major_minor fwd
| table fwd ip fwd_type os arch version major_minor fleet_on_version last_seen
