``` LF-09 | Deployment Clients Not Phoning Home or Failing App Installs
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry LF-09. https://www.amazon.com/dp/B0HRXCT384

    Run on: DS for the phone-home history (it is in the DS's own
    splunkd_access).
    Query: Main query
    If this returns nothing, run probes/LF-09-probe.spl to confirm the data it
    reads exists here.
```
index=_internal sourcetype=splunkd_access uri="*/broker/phonehome/*"
    earliest=-7d
| eval ph=split(mvindex(split(uri, "connection_"), 1), "_")
| eval client_ip=mvindex(ph, 0), client_host=mvindex(ph, 2),
       client_name=mvindex(ph, 3)
| stats latest(_time) as last_phonehome count as phonehomes
        latest(client_ip) as ip latest(client_name) as client_name
        by client_host
| eval minutes_since=round((now() - last_phonehome) / 60, 0)
| where minutes_since >= 30
| convert ctime(last_phonehome)
| sort - minutes_since
