``` SR-10 | Users Blocked by Search Disk Quota or Concurrency Limits
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry SR-10. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH, and SH-local for current disk use.
    Query: Main query
    If this returns nothing, run probes/SR-10-probe.spl,
    probes/SR-10-probe-rest.spl to confirm the data it reads exists here.
```
index=_internal earliest=-24h
    ("disk usage quota" OR "srchDiskQuota" OR "concurrent searches"
     OR "srchJobsQuota" OR "maximum number of concurrent")
    (sourcetype=splunkd OR sourcetype=scheduler
     OR sourcetype=splunk_search_messages)
| rex field=_raw "(?i)user[=:\s]+\"?(?<quota_user>[\w.@-]+)"
| eval quota_user=coalesce(quota_user, user),
       quota=case(match(_raw, "(?i)disk"),      "DISK (srchDiskQuota)",
                  match(_raw, "(?i)role|user"), "ROLE JOBS (srchJobsQuota)",
                  true(),                       "INSTANCE CONCURRENCY")
| stats count as blocked latest(_time) as last_blocked by quota_user quota
| convert ctime(last_blocked)
| sort - blocked
