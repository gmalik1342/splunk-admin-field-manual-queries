``` SR-12 | Slow or Failing Knowledge Bundle Replication to Peers
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry SR-12. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH.
    Query: Main query
    If this returns nothing, run probes/SR-12-probe.spl to confirm the data it
    reads exists here.
```
index=_internal sourcetype=splunkd earliest=-24h
    (component=DistributedBundleReplicationManager
     OR component=BundleReplicationProvider OR component=DistributedPeerManager)
    ("bundle" OR "replication")
| rex field=_raw "\belapsed_ms=(?<elapsed_ms>\d+)"
| rex field=_raw "\btar_elapsed_ms=(?<tar_ms>\d+)"
| rex field=_raw "\bbundle_file_size=(?<bundle_kb>\d+)"
| rex field=_raw "(?i)peer[_ ]?(?:name|uri)?[=:\s]+\"?(?<peer>[\w.:-]+)"
| eval failed=if(log_level="ERROR" OR match(_raw, "(?i)fail"), 1, 0)
| stats count as events sum(failed) as failures
        median(elapsed_ms) as median_ms max(elapsed_ms) as max_ms
        median(tar_ms) as median_tar_ms
        max(bundle_kb) as max_bundle_kb values(peer) as peers_failing
        by host
| eval max_bundle_mb=round(max_bundle_kb / 1024, 1),
       peers_failing=if(failures > 0, peers_failing, null())
| table host events failures median_ms max_ms median_tar_ms max_bundle_mb
        peers_failing
