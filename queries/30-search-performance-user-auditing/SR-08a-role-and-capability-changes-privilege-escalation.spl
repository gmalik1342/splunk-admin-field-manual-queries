``` SR-08 | Role and Capability Changes: Privilege Escalation
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry SR-08. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH for the change history.
    Query: Main query
    If this returns nothing, run probes/SR-08-probe.spl,
    probes/SR-08-probe-rest.spl to confirm the data it reads exists here.
```
index=_internal sourcetype=splunkd_access earliest=-30d
    (method=POST OR method=DELETE)
    (uri="*/authentication/users*" OR uri="*/authorization/roles*"
     OR uri="*/admin/SAML-groups*" OR uri="*/admin/LDAP-groups*"
     OR uri="*/authorization/tokens*")
    NOT uri="*/authentication/users/*/acknowledge*"
| rex field=uri "/(?<object_type>users|roles|SAML-groups|LDAP-groups|tokens)"
| rex field=uri "(?:users|roles|groups|tokens)/(?<object>[^/?\s]+)"
| eval object=urldecode(coalesce(object, "(new)")),
       change=case(method="DELETE", "DELETE",
                   object="(new)", "CREATE", true(), "MODIFY")
| where status < 400
| table _time host user clientip change object_type object status
| sort 0 - _time
