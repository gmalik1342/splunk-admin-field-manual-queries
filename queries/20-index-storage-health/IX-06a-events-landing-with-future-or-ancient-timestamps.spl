``` IX-06 | Events Landing With Future or Ancient Timestamps
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry IX-06. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH.
    Query: Main query
    If this returns nothing, run probes/IX-06-probe.spl to confirm the data it
    reads exists here.
```
index=_internal sourcetype=splunkd component=DateParserVerbose earliest=-24h
| rex field=_raw
    "source::(?<d_source>[^|]+)\|host::(?<d_host>[^|]+)\|(?<d_st>[^|]+)\|"
| eval data_sourcetype=coalesce(data_sourcetype, d_st),
       data_host=coalesce(data_host, d_host),
       data_source=coalesce(data_source, d_source)
| eval issue=case(
    match(_raw, "Failed to parse timestamp"),            "NO TIMESTAMP FOUND",
    match(_raw, "outside of the acceptable time window"),"OUT OF WINDOW",
    match(_raw, "too far away from the previous"),       "JUMP VS PREV EVENT",
    match(_raw, "suspiciously far away"),                "SUSPICIOUS JUMP",
    true(),                                              "OTHER")
| stats count dc(data_host) as hosts values(data_source) as sample_sources
        by data_sourcetype issue
| eval sample_sources=mvindex(sample_sources, 0, 2)
| sort - count
