``` IX-01 | Bucket Replication Lag Between Peers
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry IX-01. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH for link errors, CM for the streaming backlog.
    Query: Main query
    If this returns nothing, run probes/IX-01-probe.spl,
    probes/IX-01-probe-rest.spl to confirm the data it reads exists here.
```
index=_internal sourcetype=splunkd earliest=-4h
    (component=BucketReplicator OR component=CMRepJob
     OR component=CMReplicationRegistry OR component=RawdataHashMarkReader)
    (log_level=WARN OR log_level=ERROR)
| rex field=_raw
    "(?:ip|target_ip|peer_ip)=(?<target_ip>\d{1,3}(?:\.\d{1,3}){3})"
| rex field=_raw "\]\s+-\s+(?<msg>.+)$"
| eval msg_sig=replace(msg, "\S+~\d+~[0-9A-F-]+", "BUCKET")
| eval msg_sig=replace(msg_sig, "[0-9a-fA-F-]{16,}", "GUID")
| eval msg_sig=replace(msg_sig, "\d+", "N")
| stats count dc(msg_sig) as distinct_errors
        values(msg_sig) as signatures latest(_time) as last_seen
        by host target_ip
| convert ctime(last_seen)
| sort - count
