``` IX-10 | Index-Time Latency: Forwarding Delay vs. Clock Drift
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry IX-10. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH.
    Query: Main query
```
index=* _index_earliest=-15m@m _index_latest=now earliest=-7d latest=+1d
| fields _time _indextime host sourcetype index
| eval lag_s=_indextime - _time
| stats count
        perc50(lag_s) as p50_lag_s
        perc95(lag_s) as p95_lag_s
        min(lag_s) as min_lag_s
        max(lag_s) as max_lag_s
        by index sourcetype host
| eval tz_suspect=if(abs(round(p50_lag_s / 3600) * 3600 - p50_lag_s) < 120
                     AND abs(p50_lag_s) >= 3500, "YES", "no")
| where p95_lag_s > 300 OR min_lag_s < -60
| sort - p95_lag_s
