``` CL-12 | Multisite: Down Site or Cross-Site Replication Imbalance
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry CL-12. https://www.amazon.com/dp/B0HRXCT384

    Run on: CM.
    Query: Main query
    If this returns nothing, run probes/CL-12-probe-rest1.spl,
    probes/CL-12-probe-rest2.spl to confirm the data it reads exists here.
```
| rest splunk_server=local /services/cluster/master/peers
| eval up=if(status="Up",1,0), searchable=if(is_searchable="1" OR
    is_searchable=1,1,0)
| stats count as peers sum(up) as peers_up sum(searchable) as peers_searchable
    sum(bucket_count) as buckets by site
| eventstats sum(buckets) as cluster_buckets
| eval pct_peers_up=round(100*peers_up/peers,1),
       pct_of_buckets=round(100*buckets/cluster_buckets,1)
| appendcols
    [| rest splunk_server=local /services/cluster/config
     | table site_replication_factor site_search_factor available_sites
         multisite]
| table site peers peers_up pct_peers_up peers_searchable buckets pct_of_buckets
        site_replication_factor site_search_factor available_sites
