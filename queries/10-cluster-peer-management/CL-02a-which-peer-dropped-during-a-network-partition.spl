``` CL-02 | Which Peer Dropped During a Network Partition
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry CL-02. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH for the transition history, CM for live heartbeat state.
    Query: Main query
    If this returns nothing, run probes/CL-02-probe.spl,
    probes/CL-02-probe-rest.spl to confirm the data it reads exists here.
```
index=_internal sourcetype=splunkd component=CMPeer "transitioning" earliest=-4h
| rex field=_raw "peer_name=(?<peer_name>\S+)"
| rex field=_raw "from=(?<from_state>\w+)\s+to=(?<to_state>\w+)"
| rex field=_raw "reason=\"(?<reason>[^\"]+)\""
| where to_state="Down" OR from_state="Down"
| eval transition=from_state." -> ".to_state
| table _time host peer_name transition reason
| sort 0 _time
