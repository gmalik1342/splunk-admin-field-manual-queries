``` CL-11 | SHC Deployer Push Audit
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry CL-11. https://www.amazon.com/dp/B0HRXCT384

    Run on: DEP for the PUSH_REQUEST rows.
    Query: Main query
    If this returns nothing, run probes/CL-11-probe.spl to confirm the data it
    reads exists here.
```
index=_internal earliest=-7d
    ( (sourcetype=splunkd_access method=POST (uri="*shcluster*" OR
        uri="*/apps/deploy*"))
   OR (sourcetype=splunkd (component=SHC* OR component=ApplicationManager OR
       component=DeployedApplication)
          (bundle OR deploy OR "app ") (log_level=WARN OR log_level=ERROR)) )
| rex field=_raw "\]\s+-\s+(?<msg>.+)$"
| eval row=if(sourcetype="splunkd_access","PUSH_REQUEST","MEMBER_ERROR"),
       actor=if(sourcetype="splunkd_access", user." @ ".clientip, null())
| table _time host row actor uri status component msg
| sort 0 _time
