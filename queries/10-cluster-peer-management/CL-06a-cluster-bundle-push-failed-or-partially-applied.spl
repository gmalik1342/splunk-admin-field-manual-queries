``` CL-06 | Cluster Bundle Push Failed or Partially Applied
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry CL-06. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH for the error timeline, CM for the per-peer sync state.
    Query: Main query
    If this returns nothing, run probes/CL-06-probe.spl,
    probes/CL-06-probe-rest.spl to confirm the data it reads exists here.
```
index=_internal earliest=-24h
    ( (sourcetype=splunkd_access method=POST
          (uri="*/cluster/*/control/default/apply*" OR
              uri="*/cluster/*/control/default/validate_bundle*"))
   OR (sourcetype=splunkd "bundle" (log_level=WARN OR log_level=ERROR)
          (component=CM* OR component=ClusterBundle* OR
              component=ApplicationManager)) )
| rex field=_raw "\]\s+-\s+(?<msg>.+)$"
| eval actor=if(sourcetype="splunkd_access", user." @ ".clientip, null())
| eval row=if(sourcetype="splunkd_access", "PUSH_REQUEST", "BUNDLE_ERROR")
| table _time host row actor status component msg
| sort 0 _time
