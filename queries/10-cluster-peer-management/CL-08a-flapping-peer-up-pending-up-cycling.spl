``` CL-08 | Flapping Peer: Up → Pending → Up Cycling
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry CL-08. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH.
    Query: Main query
    If this returns nothing, run probes/CL-08-probe.spl to confirm the data it
    reads exists here.
```
index=_internal sourcetype=splunkd component=CMPeer "transitioning"
    earliest=-24h
| rex field=_raw "peer_name=(?<peer_name>\S+)"
| rex field=_raw "from=(?<from_state>\w+)\s+to=(?<to_state>\w+)"
| rex field=_raw "reason=\"(?<reason>[^\"]+)\""
| bin _time span=1h
| stats count as transitions values(to_state) as states_hit
        values(reason) as reasons by _time peer_name
| where transitions>=4
| sort - transitions
