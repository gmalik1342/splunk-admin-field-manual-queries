``` CL-07 | Peer Stuck in Decommissioning After offline --enforce-counts
    Splunk Administrator Field Manual - Gaurav Malik

    Use case: A peer was taken offline with splunk offline --enforce-counts
    and has sat in Decommissioning for hours; determine what is blocking
    completion.
    Run on: SH for the duration, CM for the blockers.
    Query: Main query
    If this returns nothing, run probes/CL-07-probe.spl,
    probes/CL-07-probe-rest1.spl, probes/CL-07-probe-rest2.spl to confirm the
    data it reads exists here.
```
index=_internal sourcetype=splunkd component=CMPeer "transitioning"
    earliest=-48h
| rex field=_raw "peer_name=(?<peer_name>\S+)"
| rex field=_raw "from=(?<from_state>\w+)\s+to=(?<to_state>\w+)"
| where to_state="Decommissioning" OR from_state="Decommissioning"
| stats min(eval(if(to_state="Decommissioning",_time,null()))) as entered
        max(eval(if(from_state="Decommissioning",_time,null()))) as exited
        latest(to_state) as last_state
        by peer_name
| eval hours_in_decom=round((coalesce(exited,now())-entered)/3600,2),
       outcome=if(isnull(exited), "STILL DECOMMISSIONING",
                  "EXITED -> " . last_state)
| convert ctime(entered) ctime(exited)
| table peer_name entered exited hours_in_decom outcome
