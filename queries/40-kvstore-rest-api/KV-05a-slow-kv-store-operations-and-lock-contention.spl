``` KV-05 | Slow KV Store Operations and Lock Contention
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry KV-05. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH.
    Query: Main query
    If this returns nothing, run probes/KV-05-probe.spl to confirm the data it
    reads exists here.
```
index=_internal sourcetype=mongod earliest=-4h ("Slow query" OR "ms")
| rex field=_raw "\"durationMillis\":(?<dur_json>\d+)"
| rex field=_raw "\s(?<dur_text>\d+)ms\s*$"
| rex field=_raw "\"ns\":\"(?<ns_json>[^\"]+)\""
| rex field=_raw "\s(?:query|command|update|remove|insert)\s+(?<ns_text>\S+)"
| eval duration_ms=tonumber(coalesce(dur_json, dur_text)),
       ns=coalesce(ns_json, ns_text)
| where duration_ms >= 100
| stats count as slow_ops median(duration_ms) as median_ms
        perc95(duration_ms) as p95_ms max(duration_ms) as max_ms
        by host ns
| sort - slow_ops
