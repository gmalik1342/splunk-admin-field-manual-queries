``` KV-09 | Configuration Changes Made Through REST
    Interpretation and RCA: Splunk Administrator Field Manual (Gaurav Malik),
    entry KV-09. https://www.amazon.com/dp/B0HRXCT384

    Run on: SH, against the _internal of the instance whose configuration
    changed.
    Query: Main query
    If this returns nothing, run probes/KV-09-probe.spl to confirm the data it
    reads exists here.
```
index=_internal sourcetype=splunkd_access earliest=-30d
    (method=POST OR method=DELETE)
    (uri="*/configs/conf-*" OR uri="*/properties/*" OR uri="*/data/inputs/*"
     OR uri="*/data/indexes*" OR uri="*/server/settings*"
     OR uri="*/apps/local*" OR uri="*/apps/appinstall*"
     OR uri="*/deployment/server/*")
    NOT user=splunk-system-user NOT user="-"
| eval path=mvindex(split(uri, "?"), 0)
| rex field=path "/(?:configs/conf-|properties/)(?<conf_file>[^/]+)"
| rex field=path "/(?:configs/conf-|properties/)[^/]+/(?<stanza>[^/]+)"
| rex field=path
    "/data/(?<data_area>inputs/[^/]+|indexes)(?:/(?<data_obj>[^/]+))?"
| rex field=path "/apps/(?:local|appinstall)(?:/(?<app_name>[^/]+))?"
| eval target=case(isnotnull(conf_file), conf_file . ".conf",
                   isnotnull(data_area), data_area,
                   like(path, "%/apps/%"), "app",
                   like(path, "%/server/settings%"), "server/settings",
                   true(), "deployment server"),
       object=urldecode(coalesce(stanza, data_obj, app_name, "")),
       change=if(method="DELETE", "DELETE", "WRITE")
| where status < 400
| table _time host user clientip change target object status
| sort 0 - _time
