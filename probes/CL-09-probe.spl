``` Probe for CL-09: checks that the data CL-09 reads exists on this
    deployment. One row per data source: OK, or MISSING. MISSING means the
    entry's query cannot see that data here (not forwarded, no access, or a
    different component name on this version). See Appendix A in the book.
```
earliest=-1d
    (index=_internal sourcetype=splunkd component=SHCRaftConsensus)
    OR (index=_internal sourcetype=splunkd component=SHCMaster)
    OR (index=_internal sourcetype=splunkd component=SHCSlave)
| eval check=mvappend(if(searchmatch("index=_internal sourcetype=splunkd component=SHCRaftConsensus"), "_internal splunkd component=SHCRaftConsensus", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd component=SHCMaster"), "_internal splunkd component=SHCMaster", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd component=SHCSlave"), "_internal splunkd component=SHCSlave", null()))
| mvexpand check
| stats count as events dc(host) as hosts latest(_time) as last_seen by check
| append
    [| makeresults
     | eval check=split("_internal splunkd component=SHCRaftConsensus;_internal splunkd component=SHCMaster;_internal splunkd component=SHCSlave", ";")
     | mvexpand check
     | eval events=0, hosts=0
     | fields check events hosts]
| stats max(events) as events max(hosts) as hosts max(last_seen) as last_seen
        by check
| eval status=if(events > 0, "OK", "MISSING")
| convert ctime(last_seen)
| table check status events hosts last_seen
