``` Probe for KV-06: checks that the data KV-06 reads exists on this
    deployment. One row per data source: OK, or MISSING. MISSING means the
    entry's query cannot see that data here (not forwarded, no access, or a
    different component name on this version). See Appendix A in the book.
```
earliest=-30d
    (index=_internal sourcetype=splunkd component=KVStore*)
    OR (index=_internal sourcetype=splunkd component=KVStorage*)
    OR (index=_internal sourcetype=splunkd_access)
| eval check=mvappend(if(searchmatch("index=_internal sourcetype=splunkd component=KVStore*"), "_internal splunkd component=KVStore*", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd component=KVStorage*"), "_internal splunkd component=KVStorage*", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd_access"), "_internal sourcetype=splunkd_access", null()))
| mvexpand check
| stats count as events dc(host) as hosts latest(_time) as last_seen by check
| append
    [| makeresults
     | eval check=split("_internal splunkd component=KVStore*;_internal splunkd component=KVStorage*;_internal sourcetype=splunkd_access", ";")
     | mvexpand check
     | eval events=0, hosts=0
     | fields check events hosts]
| stats max(events) as events max(hosts) as hosts max(last_seen) as last_seen
        by check
| eval status=if(events > 0, "OK", "MISSING")
| convert ctime(last_seen)
| table check status events hosts last_seen
