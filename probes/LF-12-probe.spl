``` Probe for LF-12: checks that the data LF-12 reads exists on this
    deployment. One row per data source: OK, or MISSING. MISSING means the
    entry's query cannot see that data here (not forwarded, no access, or a
    different component name on this version). See Appendix A in the book.
```
earliest=-1d
    (index=_internal sourcetype=splunkd component=ThruputProcessor)
    OR (index=_internal source=*metrics.log group=thruput)
    OR (index=_internal source=*metrics.log group=pipeline)
| eval check=mvappend(if(searchmatch("index=_internal sourcetype=splunkd component=ThruputProcessor"), "_internal splunkd component=ThruputProcessor", null()),
                   if(searchmatch("index=_internal source=*metrics.log group=thruput"), "_internal metrics.log group=thruput", null()),
                   if(searchmatch("index=_internal source=*metrics.log group=pipeline"), "_internal metrics.log group=pipeline", null()))
| mvexpand check
| stats count as events dc(host) as hosts latest(_time) as last_seen by check
| append
    [| makeresults
     | eval check=split("_internal splunkd component=ThruputProcessor;_internal metrics.log group=thruput;_internal metrics.log group=pipeline", ";")
     | mvexpand check
     | eval events=0, hosts=0
     | fields check events hosts]
| stats max(events) as events max(hosts) as hosts max(last_seen) as last_seen
        by check
| eval status=if(events > 0, "OK", "MISSING")
| convert ctime(last_seen)
| table check status events hosts last_seen
