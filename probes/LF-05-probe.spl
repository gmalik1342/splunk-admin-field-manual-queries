``` Probe for LF-05: checks that the data LF-05 reads exists on this
    deployment. One row per data source: OK, or MISSING. MISSING means the
    entry's query cannot see that data here (not forwarded, no access, or a
    different component name on this version). See Appendix A in the book.
```
earliest=-1d
    (index=_internal source=*license_usage.log*)
    OR (index=_internal source=*metrics.log group=per_host_thruput)
| eval check=mvappend(if(searchmatch("index=_internal source=*license_usage.log*"), "_internal license_usage.log (license manager)", null()),
                   if(searchmatch("index=_internal source=*metrics.log group=per_host_thruput"), "_internal metrics.log group=per_host_thruput", null()))
| mvexpand check
| stats count as events dc(host) as hosts latest(_time) as last_seen by check
| append
    [| makeresults
     | eval check=split("_internal license_usage.log (license manager);_internal metrics.log group=per_host_thruput", ";")
     | mvexpand check
     | eval events=0, hosts=0
     | fields check events hosts]
| stats max(events) as events max(hosts) as hosts max(last_seen) as last_seen
        by check
| eval status=if(events > 0, "OK", "MISSING")
| convert ctime(last_seen)
| table check status events hosts last_seen
