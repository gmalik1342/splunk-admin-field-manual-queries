``` Probe for IX-11: checks that the data IX-11 reads exists on this
    deployment. One row per data source: OK, or MISSING. MISSING means the
    entry's query cannot see that data here (not forwarded, no access, or a
    different component name on this version). See Appendix A in the book.
```
earliest=-4h
    (index=_internal sourcetype=splunkd component=CacheManager)
    OR (index=_internal sourcetype=splunkd component=S3Client)
    OR (index=_internal sourcetype=splunkd component=RemoteStorage*)
    OR (index=_internal sourcetype=splunkd component=AzureBlob*)
    OR (index=_internal sourcetype=splunkd component=GCS*)
| eval check=mvappend(if(searchmatch("index=_internal sourcetype=splunkd component=CacheManager"), "_internal splunkd component=CacheManager", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd component=S3Client"), "_internal splunkd component=S3Client", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd component=RemoteStorage*"), "_internal splunkd component=RemoteStorage*", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd component=AzureBlob*"), "_internal splunkd component=AzureBlob*", null()),
                   if(searchmatch("index=_internal sourcetype=splunkd component=GCS*"), "_internal splunkd component=GCS*", null()))
| mvexpand check
| stats count as events dc(host) as hosts latest(_time) as last_seen by check
| append
    [| makeresults
     | eval check=split("_internal splunkd component=CacheManager;_internal splunkd component=S3Client;_internal splunkd component=RemoteStorage*;_internal splunkd component=AzureBlob*;_internal splunkd component=GCS*", ";")
     | mvexpand check
     | eval events=0, hosts=0
     | fields check events hosts]
| stats max(events) as events max(hosts) as hosts max(last_seen) as last_seen
        by check
| eval status=if(events > 0, "OK", "MISSING")
| convert ctime(last_seen)
| table check status events hosts last_seen
