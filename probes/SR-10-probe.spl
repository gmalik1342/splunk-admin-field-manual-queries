``` Probe for SR-10: checks that the data SR-10 reads exists on this
    deployment. One row per data source: OK, or MISSING. MISSING means the
    entry's query cannot see that data here (not forwarded, no access, or a
    different component name on this version). See Appendix A in the book.
```
earliest=-1d
    (index=_internal sourcetype=splunkd)
    OR (index=_internal sourcetype=scheduler)
    OR (index=_internal sourcetype=splunk_search_messages)
| eval check=mvappend(if(searchmatch("index=_internal sourcetype=splunkd"), "_internal sourcetype=splunkd", null()),
                   if(searchmatch("index=_internal sourcetype=scheduler"), "_internal sourcetype=scheduler", null()),
                   if(searchmatch("index=_internal sourcetype=splunk_search_messages"), "_internal sourcetype=splunk_search_messages", null()))
| mvexpand check
| stats count as events dc(host) as hosts latest(_time) as last_seen by check
| append
    [| makeresults
     | eval check=split("_internal sourcetype=splunkd;_internal sourcetype=scheduler;_internal sourcetype=splunk_search_messages", ";")
     | mvexpand check
     | eval events=0, hosts=0
     | fields check events hosts]
| stats max(events) as events max(hosts) as hosts max(last_seen) as last_seen
        by check
| eval status=if(events > 0, "OK", "MISSING")
| convert ctime(last_seen)
| table check status events hosts last_seen
